# LATTE deployment environment variables.

# Web application ports exposed to host.
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

# LATTE connector entity extractor port exposed to host.
CONNECTOR_PORT=8000

# Neo4j database ports exposed to host.
NEO4J_HTTP_PORT=7477
NEO4J_BOLT_PORT=7700

# Neo4j authentication and database name.
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DB_NAME=latte

# LATTE connector repository settings.
CONNECTOR_REPO=https://github.com/DariahBE/LATTE_connector.git
CONNECTOR_BRANCH=main
CONNECTOR_CACHEBUST=1

# Matomo analytics port and database settings.
MATOMO_PORT=8080
MATOMO_DB_NAME=matomo
MATOMO_DB_USER=matomo
MATOMO_DB_PASSWORD=matomo_password
MATOMO_DB_ROOT_PASSWORD=matomo_root_password
